{
  "name": "Week 11 Airflow + Agents",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "airflow",
  "workspaceFolder": "/opt/airflow",
  "forwardPorts": [8080, 8501, 5432],
  "portsAttributes": {
    "8080": { "label": "Airflow UI" },
    "8501": { "label": "Agent dashboard" },
    "5432": { "label": "PostgreSQL" }
  },
  "postCreateCommand": "python /opt/airflow/scripts/generate_data.py || true",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-azuretools.vscode-docker"]
    }
  }
}
